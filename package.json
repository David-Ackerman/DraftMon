{
  "name": "draftmon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "preview": "pnpm start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "content": "node scripts/generate-content.mjs",
    "start": "turbo run start",
    "db:migrate": "pnpm --filter @draftmon/db migrate"
  },
  "devDependencies": {
    "@draftmon/engine": "workspace:*",
    "@eslint/js": "^9.25.0",
    "@next/eslint-plugin-next": "^16.4.6",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "turbo": "^2.11.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "3.2.4",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.7"
  }
}
